[[ -f "$HOME/.zsh/sources.zsh" ]] && source "$HOME/.zsh/sources.zsh"

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME=""

zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 7
export UPDATE_ZSH_DAYS=7
export ZSH_CUSTOM_AUTOUPDATE_QUIET=true

ENABLE_CORRECTION="false"
COMPLETION_WAITING_DOTS="true"
EDITOR="nano"

plugins=(
    aliases
    branch
    brew
    colored-man-pages
    colorize
    command-not-found
    debian
{% if generic_check_docker %}
    docker
    docker-compose
{% endif %}
    eza
    fzf
    git
    history
    pip
    python
    rsync
    screen
    ssh
    starship
    systemd
    tmux
    ufw
    urltools
    virtualenv
    zoxide
    zsh-interactive-cd
    zsh-navigation-tools
    autoupdate
    zsh-autosuggestions
    zsh-completions
    zsh-syntax-highlighting
    zsh-you-should-use
)

source $ZSH/oh-my-zsh.sh

export PATH=$HOME/.local/bin:$PATH
export LANG=en_US.UTF-8
