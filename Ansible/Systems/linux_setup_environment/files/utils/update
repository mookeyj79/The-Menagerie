#!/usr/bin/env zsh

set -e
source /opt/scripts/libs/colors.shlib

REAL_USER=${SUDO_USER:-$USER}
if [ "$EUID" -eq 0 ] && [ "$REAL_USER" != "root" ]; then
    printf "${RED}[!]${RESET} This script should not be run via 'sudo ./update'.\n" >&2
    printf "${RED}[!]${RESET} Please run it as your regular user (e.g. '$REAL_USER'), not as root.\n"  >&2
    exit 1
fi

if ! sudo -v; then
    printf "${RED}[!]${RESET} This script must be run as root. Exiting.\n" >&2
    exit 1
fi

SYSTEM_OS="UNKNOWN"
if [ -f /etc/os-release ]; then
    source /etc/os-release

    if [[ "$ID_LIKE" == *debian* || "$ID" == *debian* ]]; then
        SYSTEM_OS="DEBIAN"
    elif [[ "$ID_LIKE" == *rhel* || "$ID_LIKE" == *fedora* || "$ID" == *rhel* ]]; then
        SYSTEM_OS="REDHAT"
    fi
else
    printf "${RED}[!]${RESET} Cannot determine OS: /etc/os-release not found.\n" >&2
    exit 1
fi

printf "${GREEN}[*]${RESET} Updating $(hostname)...\n"
if [[ "$SYSTEM_OS" == "DEBIAN" ]]; then
    sudo apt update && \
    sudo apt full-upgrade -y && \
    sudo apt autoremove --purge -y && \
    sudo apt autoclean && \
    sudo apt clean
elif [[ "$SYSTEM_OS" == "REDHAT" ]]; then
    sudo dnf update
else
    printf "${YELLOW}[!]${RESET} Cannot determine OS: Skipping update.\n" >&2
fi

printf "\n${GREEN}[*]${RESET} Updating Starship...\n"
TMP_STARSHIP_INSTALLER=$(mktemp)
trap 'rm -f "$TMP_STARSHIP_INSTALLER"' EXIT
curl -sS https://starship.rs/install.sh -o "$TMP_STARSHIP_INSTALLER"
sudo sh "$TMP_STARSHIP_INSTALLER" -y > /dev/null
rm -f "$TMP_STARSHIP_INSTALLER"

printf "\n${GREEN}[*]${RESET} Updating Oh My Zsh...\n"
ZSH="$HOME/.oh-my-zsh"
ZSH_DIR="$ZSH"
ZSH_CACHE_DIR="$ZSH/cache"
ZSH_CUSTOM="$ZSH/custom"
source "$ZSH/custom/plugins/autoupdate/autoupdate.plugin.zsh"
if [ -d "$ZSH_DIR" ]; then
    "$ZSH_DIR/tools/upgrade.sh" > /dev/null
    upgrade_oh_my_zsh_custom > /dev/null
    mkdir -p "$ZSH_DIR/cache"
    echo "LAST_EPOCH=$(( $(date +%s) / 60 / 60 / 24 ))" > "$ZSH_DIR/cache/.zsh-update"
else
    printf "${YELLOW}[!]${RESET} Oh My Zsh not found in \$HOME/.oh-my-zsh — skipping.\n"
fi

printf "\n${GREEN}[✓]${RESET} System update complete.\n"
