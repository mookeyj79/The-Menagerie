version 15.1
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname Router3
!
! Config version: 3.5 (was 3.3)
! Changes from 3.4:
!  - Rotated Creds
!
boot-start-marker
boot-end-marker
!
shell processing full
!
! confcrypt v2 YWdlLWVuY3J5cHRpb24ub3JnL3YxCi0--lA4LP2Y3juCywVcg1X9xhbHRjKONy-czS84EeH5sxI6ow0v_ze5LWJOwhQk8f_-Viczq7UGbTZu0Os4njoxsAP1l5HJ4ZsWfLX7rdZYBqqw9naH6op5cY9j3zgyUt5V9x0gLcjY5UWVrlWQo
enable secret 9 REDACTED
!
no aaa new-model
!
no network-clock-participate slot 2
!
dot11 syslog
no ip source-route
!
ip cef
!
!
no ip dhcp use vrf connected
ip dhcp excluded-address 192.168.19.65 192.168.19.69
ip dhcp excluded-address 192.168.21.1 192.168.21.49
!
ip dhcp pool RETRONET-DHCP
  network 192.168.21.0 255.255.255.192
  default-router 192.168.21.1
  dns-server 192.168.21.1
  lease 0 6
!
ip dhcp pool SMARTHOME-DHCP
  network 192.168.19.64 255.255.255.240
  default-router 192.168.19.65
  dns-server 192.168.19.65
  lease 0 6
!
!
ip domain name mikewashere.lan
ip name-server 192.168.3.5
ip name-server 192.168.3.9
ip name-server 1.1.1.1
ip name-server 9.9.9.9
ip inspect name RETRONET-OUT tcp
ip inspect name RETRONET-OUT udp
ip inspect name RETRONET-OUT icmp
ip inspect name SMARTHOME-OUT tcp
ip inspect name SMARTHOME-OUT udp
ip inspect name SMARTHOME-OUT icmp
no ipv6 cef
!
multilink bundle-name authenticated
!
!
!
!
!
voice-card 0
!
!
!
!
!
!
!
crypto pki token default removal timeout 0
!
!
!
!
license udi pid CISCO3825 sn FTX1339AJQU
! confcrypt v2 YWdlLWVuY3J5cHRpb24ub3JnL3YxCi0--IvQn_96CUe5ROKLHCJT1vfY2Re0ip9xNGwiFkbonTLQ14PpoaMwMHctuym0JV2BpTpyvKEQvb75emB3UrnsFYkpt1REGunjMWDjY76ac2cFJoo1Ny239Hubs6FOyC5o
username REDACTED secret 9 REDACTED
! confcrypt v2 YWdlLWVuY3J5cHRpb24ub3JnL3YxCi0--nuIl5S8D1GSB2k6Xv-NoK2CZUMQaU2IBOmV7IQax09IZHLhn7qe833mY5iSf2ZyVZ_r3QftaYMFYU06R2s10NK9ctmnwtR3vLW7_hHi4LWUs2707YcsKbORXcexeJdWqyR5LpKSfxHkJS0GYt7w
username REDACTED secret 9 REDACTED
!
redundancy
!
!
ip ssh time-out 60
ip ssh authentication-retries 2
ip ssh version 2
ip ssh pubkey-chain
  username wonka
! confcrypt v2 YWdlLWVuY3J5cHRpb24ub3JnL3YxCi0-_CNQJtLBBQc-LEq0-ewFVgiiYCosPAnoTOGDwd9brSjEgYidYpOIXRChOhR4Cu
key-hash ssh-rsa REDACTED
  quit
!
!
!
!
!
!
!
!
interface Loopback0
  ip address 192.168.254.3 255.255.255.255
!
interface GigabitEthernet0/0
  no ip address
  duplex auto
  speed auto
  media-type rj45
!
interface GigabitEthernet0/0.302
  encapsulation dot1Q 302
  ip address 192.168.3.6 255.255.255.252
  ip ospf authentication message-digest
! confcrypt v2 YWdlLWVuY3J5cHRpb24ub3JnL3YxCi0--B2wDRhlFuY-w
ip ospf message-digest-key 1 md5 7 REDACTED
  ip ospf 1 area 0
!
interface GigabitEthernet0/1
  no ip address
  duplex auto
  speed auto
  media-type rj45
!
interface GigabitEthernet0/1.303
  encapsulation dot1Q 303
  ip address 192.168.3.10 255.255.255.252
  ip ospf authentication message-digest
! confcrypt v2 YWdlLWVuY3J5cHRpb24ub3JnL3YxCi0-_EKiA
ip ospf message-digest-key 1 md5 7 REDACTED
  ip ospf 1 area 0
!
interface GigabitEthernet1/0
  no ip address
!
interface GigabitEthernet1/0.19
  description Internal - Smart Home
  encapsulation dot1Q 19
  ip address 192.168.19.65 255.255.255.240
  ip access-group SMARTHOME-IN in
  ip inspect SMARTHOME-OUT out
!
interface GigabitEthernet1/0.21
  description Internal - RetroNet
  encapsulation dot1Q 21
  ip address 192.168.21.1 255.255.255.192
  ip access-group RETRONET-IN in
  ip inspect RETRONET-OUT out
!
interface GigabitEthernet1/0.101
  description Hardware Management
  encapsulation dot1Q 101
  ip address 10.0.1.33 255.255.255.240
!
interface FastEthernet2/0
  no ip address
  shutdown
  duplex auto
  speed auto
!
interface FastEthernet2/1
  no ip address
  shutdown
  duplex auto
  speed auto
!
interface Async0/2/0
  ip unnumbered Loopback0
  ip virtual-reassembly in
  encapsulation ppp
  ip tcp header-compression
  dialer in-band
  dialer idle-timeout 3600
  dialer-group 1
  peer default ip address pool RETRONET-LOCAL
  async mode interactive
  no keepalive
  ppp authentication pap chap
!
router ospf 1
  router-id 192.168.254.3
  passive-interface Loopback0
  passive-interface GigabitEthernet1/0.101
  passive-interface GigabitEthernet1/0.19
  passive-interface GigabitEthernet1/0.21
  network 10.0.1.32 0.0.0.15 area 0
  network 192.168.3.4 0.0.0.3 area 0
  network 192.168.3.8 0.0.0.3 area 0
  network 192.168.19.64 0.0.0.15 area 0
  network 192.168.21.0 0.0.0.63 area 0
  network 192.168.254.3 0.0.0.0 area 0
!
ip local pool RETRONET-LOCAL 192.168.21.40 192.168.21.49
ip forward-protocol nd
no ip http server
no ip http secure-server
!
!
ip dns server
!
ip access-list standard MGMT-SSH
  permit 10.0.1.0 0.0.0.15
  permit 10.0.1.16 0.0.0.15
  permit 10.0.1.32 0.0.0.15
!
ip access-list extended RETRONET-IN
  remark Legacy/dialup devices -- highest-risk segment, deny-by-default toward all internal ranges
  remark Gateway services only: DNS, DHCP, NTP, rate-limited ICMP -- matches router1/router2 pattern
  permit udp any host 192.168.21.1 eq domain
  permit udp any host 192.168.21.1 eq bootps
  permit udp any host 192.168.21.1 eq ntp
  permit icmp any host 192.168.21.1
  deny   ip any 10.0.0.0 0.255.255.255
  deny   ip any 192.168.0.0 0.0.255.255
  permit ip any any
ip access-list extended SMARTHOME-IN
  remark IoT/smart home devices -- deny-by-default toward all internal ranges
  remark Gateway services only: DNS, DHCP, NTP, rate-limited ICMP -- matches router1/router2 pattern
  permit udp any host 192.168.19.65 eq domain
  permit udp any host 192.168.19.65 eq bootps
  permit udp any host 192.168.19.65 eq ntp
  permit icmp any host 192.168.19.65
  deny   ip any 10.0.0.0 0.255.255.255
  deny   ip any 192.168.0.0 0.0.255.255
  permit ip any any
!
dialer-list 1 protocol ip permit
!
!
!
!
!
!
control-plane
!
bridge 1 protocol ieee
!
voice-port 0/1/0
  ring number 1
  timeouts power-denial 2500
  connection plar opx 5551111
  description XLink direct
  caller-id enable
!
voice-port 0/1/1
!
voice-port 0/1/2
!
voice-port 0/1/3
!
voice-port 0/3/0
  no vad
  description Modem
!
voice-port 0/3/1
  no vad
!
voice-port 0/3/2
  no vad
  description Phone 2
  caller-id enable
!
voice-port 0/3/3
  no vad
  description Phone 1
  caller-id enable
!
!
!
mgcp profile default
!
!
dial-peer voice 1101 pots
  description Phone 1
  destination-pattern 5551111
  port 0/3/3
!
dial-peer voice 1102 pots
  description Phone 2
  destination-pattern 5552222
  port 0/3/2
!
dial-peer voice 1105 pots
  description Modem
  destination-pattern 5555555
  port 0/3/0
!
dial-peer voice 2000 pots
  description Outbound 11-digit calls to XLink
  destination-pattern 1[2-9]..[2-9]......
  port 0/1/0
  forward-digits 11
!
dial-peer voice 2001 pots
  description Outbound 10-digit calls to XLink
  destination-pattern [2-9]..[2-9]......
  port 0/1/0
  forward-digits 10
!
dial-peer voice 2002 pots
  description 911 to XLink
  destination-pattern 911
  port 0/1/0
  forward-digits 3
!
!
!
!
!
line con 0
  logging synchronous
  login local
line aux 0
  no exec
  transport output none
line 0/2/0
  exec-timeout 0 0
  modem InOut
  transport preferred none
  autoselect ppp
  stopbits 1
  speed 115200
  flowcontrol hardware
line 66
  no activation-character
  no exec
  transport preferred none
  transport input all
  transport output lat pad telnet rlogin lapb-ta mop udptn v120 ssh
line vty 0 4
  access-class MGMT-SSH in
  login local
  transport input ssh
line vty 5 15
  access-class MGMT-SSH in
  login local
  transport input ssh
!
scheduler allocate 20000 1000
ntp master 4
ntp server 10.0.1.1 prefer
end
